@page
@model MapModel
@{
    ViewData["Title"] = "Harita - Kargo Konum Takip";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    #map {
        width: 100%;
        height: 500px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
</style>

<div class="container-fluid">
    <h1 class="display-6 mb-3">Kargo Konum Takip - Harita</h1>

    <div class="mb-3">
        <span id="connectionStatus" class="badge bg-danger">Disconnected</span>
    </div>

    <div class="mb-4">
        <div id="map"></div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const hubUrl = "@Model.NotificationServiceUrl" + "/locationHub";

        const statusBadge = document.getElementById("connectionStatus");

        // Leaflet map setup
        const map = L.map("map").setView([41.0082, 28.9784], 12);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(map);

        // Device tracking
        const colorPalette = ['#e6194b', '#3cb44b', '#4363d8', '#f58231', '#911eb4', '#42d4f4', '#f032e6', '#bfef45'];
        var colorIndex = 0;
        const devicePaths = {};

        function getDeviceData(deviceId) {
            if (!devicePaths[deviceId]) {
                var color = colorPalette[colorIndex % colorPalette.length];
                colorIndex++;
                devicePaths[deviceId] = {
                    color: color,
                    latlngs: [],
                    polyline: L.polyline([], { color: color, weight: 3 }).addTo(map),
                    markers: []
                };
            }
            return devicePaths[deviceId];
        }

        function setStatus(text, bgClass) {
            statusBadge.textContent = text;
            statusBadge.className = "badge " + bgClass;
        }

        function escapeHtml(text) {
            var div = document.createElement("div");
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(hubUrl)
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveLocationUpdate", function (latitude, longitude, deviceId, timestamp) {
            var device = getDeviceData(deviceId);
            var latlng = [latitude, longitude];
            device.latlngs.push(latlng);
            device.polyline.setLatLngs(device.latlngs);

            var marker = L.circleMarker(latlng, {
                radius: 5,
                color: device.color,
                fillColor: device.color,
                fillOpacity: 0.8
            }).addTo(map);

            marker.bindPopup(
                "<b>" + escapeHtml(deviceId) + "</b><br>" +
                "Lat: " + latitude.toFixed(6) + "<br>" +
                "Lng: " + longitude.toFixed(6) + "<br>" +
                "Time: " + escapeHtml(timestamp)
            );

            device.markers.push(marker);
            map.panTo(latlng);
        });

        connection.onreconnecting(function () {
            setStatus("Reconnecting...", "bg-warning text-dark");
        });

        connection.onreconnected(function () {
            setStatus("Connected", "bg-success");
        });

        connection.onclose(function () {
            setStatus("Disconnected", "bg-danger");
        });

        connection.start()
            .then(function () {
                setStatus("Connected", "bg-success");
            })
            .catch(function (err) {
                console.error("SignalR connection error: ", err);
                setStatus("Disconnected", "bg-danger");
            });
    </script>
}
