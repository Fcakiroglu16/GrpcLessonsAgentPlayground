@page
@model IndexModel
@{
    ViewData["Title"] = "Kargo Konum Takip";
}

<div class="container-fluid">
    <h1 class="display-6 mb-3">Kargo Konum Takip</h1>

    <div class="mb-3">
        <span id="connectionStatus" class="badge bg-danger">Disconnected</span>
        <a asp-page="/Map" class="btn btn-sm btn-outline-primary ms-2">Haritayı Görüntüle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Device ID</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Timestamp</th>
                    <th>Mobile App ID</th>
                </tr>
            </thead>
            <tbody id="locationTableBody">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const hubUrl = "@Model.NotificationServiceUrl" + "/locationHub";
        const maxRows = 50;

        const statusBadge = document.getElementById("connectionStatus");
        const tableBody = document.getElementById("locationTableBody");

        function setStatus(text, bgClass) {
            statusBadge.textContent = text;
            statusBadge.className = "badge " + bgClass;
        }

        function escapeHtml(text) {
            var div = document.createElement("div");
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(hubUrl)
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveLocationUpdate", function (latitude, longitude, deviceId, timestamp, mobileAppId) {
            var row = document.createElement("tr");
            row.innerHTML =
                "<td>" + escapeHtml(deviceId) + "</td>" +
                "<td>" + latitude.toFixed(6) + "</td>" +
                "<td>" + longitude.toFixed(6) + "</td>" +
                "<td>" + escapeHtml(timestamp) + "</td>" +
                "<td>" + escapeHtml(mobileAppId) + "</td>";
            tableBody.insertBefore(row, tableBody.firstChild);

            while (tableBody.rows.length > maxRows) {
                tableBody.deleteRow(tableBody.rows.length - 1);
            }
        });

        connection.onreconnecting(function () {
            setStatus("Reconnecting...", "bg-warning text-dark");
        });

        connection.onreconnected(function () {
            setStatus("Connected", "bg-success");
        });

        connection.onclose(function () {
            setStatus("Disconnected", "bg-danger");
        });

        connection.start()
            .then(function () {
                setStatus("Connected", "bg-success");
            })
            .catch(function (err) {
                console.error("SignalR connection error: ", err);
                setStatus("Disconnected", "bg-danger");
            });
    </script>
}
